# Render에서 복사한 PostgreSQL External Database URL
DATABASE_URL=postgresql://사용자:비밀번호@호스트/DB이름
# 로그인 토큰을 만들 때 쓰는 비밀 문자열 (길고 무작위로, 공개 금지). 예: openssl rand -hex 32
JWT_SECRET=
# 관리자 계정 없이 쓸 수 있는 관리자 비밀번호
ADMIN_PASSWORD=
# 접속을 허용할 프론트엔드 주소 (여러 개면 쉼표로 구분)
FRONTEND_URL=http://localhost:3000
PORT=3001
# (선택) 같은 DB를 다른 앱과 나눠 쓸 때 이 앱의 테이블을 담을 구역 이름
DB_SCHEMA=level2
